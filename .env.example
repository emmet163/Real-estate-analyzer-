# Optional. Omit for durable local JSON storage in ./data (single process).
# Do not bind this single-user app to a public interface.
DATABASE_URL=
SCOUT_DATA_DIR=./data
# Future ACS provider integration; never expose keys to the browser.
CENSUS_API_KEY=

# Optional AI. Both values are required; no fake AI runs without them.
# Choose a Responses API model with streaming and function-calling support.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional licensed listing import: absolute path to a JSON array of Listing records.
# Leave empty for honest no-feed coverage and saved manual analyses only.
SCOUT_LISTINGS_FILE=
# Set true only when authorized to use/display the imported data.
SCOUT_LISTINGS_AUTHORIZED=false
